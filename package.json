{
  "name": "tezos-wallet-e2e-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "wallet:acquire": "python3 scripts/temple_artifact.py --acquire",
    "wallet:verify": "python3 scripts/temple_artifact.py",
    "test": "node --test tests/*.test.ts && python3 -m unittest discover -s scripts -p test_temple_artifact.py",
    "temple:lifecycle": "node scripts/run-temple.mjs",
    "temple:network": "node scripts/run-temple.mjs network",
    "temple:transfer": "node scripts/run-temple.mjs transfer"
  },
  "dependencies": {
    "@ecadlabs/beacon-dapp": "4.8.4-ecad",
    "@ecadlabs/beacon-types": "4.8.4-ecad",
    "@taquito/beacon-wallet": "25.1.0",
    "@taquito/taquito": "25.1.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "blakejs": "1.2.1",
    "bs58check": "4.0.0",
    "tweetnacl": "1.0.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "overrides": {
    "@walletconnect/utils@2.18.0": {
      "query-string": "10.0.0"
    }
  }
}
