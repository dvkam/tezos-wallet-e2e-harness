{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "src",
    "e2e",
    "playwright.config.ts",
    "playwright.sandbox.config.ts",
    "vite.config.ts",
    "lib",
    "tests",
    "scripts/*.ts",
    "formal/*.ts"
  ]
}
